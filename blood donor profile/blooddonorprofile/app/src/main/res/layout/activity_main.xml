<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🩸 BLOOD DONOR PROFILE"
            android:textColor="#C62828"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formulir Biodata Pendonor Darah"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#555555"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama lengkap"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etUmur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Umur"
            android:inputType="number" />

        <EditText
            android:id="@+id/etTelepon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nomor telepon"
            android:inputType="phone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Golongan Darah"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spGolongan"
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <EditText
            android:id="@+id/etAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alamat lengkap"
            android:inputType="textPostalAddress"
            android:minLines="2"
            android:gravity="top" />

        <Switch
            android:id="@+id/swPengingat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aktifkan pengingat donor"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIMPAN BIODATA"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnHapus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HAPUS BIODATA"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HASIL BIODATA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada biodata tersimpan."
            android:textSize="15sp"
            android:textColor="#333333"
            android:background="#FFFFFF"
            android:padding="15dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>